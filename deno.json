{
  "version": "1.0.2",
  "tasks": {
    "start": "deno run --allow-net main.ts",
    "dev": "deno run --allow-net --allow-read --allow-env --allow-run --watch src/server.ts",
    "prod": "deno run --allow-net --allow-read --allow-env --allow-run --allow-sys src/server.ts",
    "test": "deno test"
  },
  "imports": {
    "@types/amqplib": "npm:@types/amqplib@^0.10.8",
    "@types/bson": "npm:@types/bson@^4.2.4",
    "@types/cors": "npm:@types/cors@^2.8.19",
    "@types/express": "npm:@types/express@^5.0.6",
    "@types/passport": "npm:@types/passport@^1.0.17",
    "@types/passport-jwt": "npm:@types/passport-jwt@^4.0.1",
    "amqplib": "npm:amqplib@^0.10.9",
    "bson": "npm:bson@^7.0.0",
    "cors": "npm:cors@^2.8.5",
    "express": "npm:express@^5.1.0",
    "mongodb": "npm:mongodb@^7.0.0",
    "passport": "npm:passport@^0.7.0",
    "passport-jwt": "npm:passport-jwt@^4.0.1",
    "pino": "npm:pino@^10.1.0",
    "pino-pretty": "npm:pino-pretty@^13.1.3"
  },
  "nodeModulesDir": "auto"
}
